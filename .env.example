# Clave de API-Football (dashboard.api-football.com). Sin clave, el sitio usa datos de ejemplo.
API_FOOTBALL_KEY=

# Cada cuántos segundos se vuelven a pedir los partidos del día.
# Plan gratis (100 pedidos/día): dejalo en 900 o más. Plan Pro: 60.
REFRESH_TODAY_SECONDS=900

# Cada cuántos segundos se actualiza la ficha de un partido en vivo.
REFRESH_LIVE_MATCH_SECONDS=300
